:root {
    {% for color in settings.colors.palette.colors %}
    --bde-palette-color-{{ color.label|lower }}: {{ color.value }};
    {% endfor %}
}

%%BOOTSTRAP_DEFAULT_SCOPE%% p,
.breakdance-rich-text-styles>p:last-child  {
    {{ macros.spacing_margin_y(settings.bric_global_spacing.spacing.paragraphs) }}
}

%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-heading,
%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-rich-text h2,
%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-rich-text h3,
%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-rich-text h4,
%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-rich-text h5,
%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-rich-text h6 {
    {{ macros.spacing_margin_y(settings.bric_global_spacing.spacing.headings) }}
}

%%BOOTSTRAP_DEFAULT_SCOPE%% .bde-button {
    {{ macros.spacing_margin_y(settings.bric_global_spacing.spacing.buttons) }}
}


{% for color in settings.colors.palette.colors %}

.breakdance .has-bd-palette-{{ color.label|lower }}-color{
    color: var( --bde-palette-color-{{  color.label|lower }} );
}

{% endfor %}
