/* Fluent Booking: inherit the site-wide Breakdance color system. */
.calendar_wrap,
.fluent_booking_app {
    --fcal_primary_color: var(--bde-brand-primary-color);
    --fcal_dark: var(--bde-headings-color);
    --fcal_body_bg: var(--bde-background-color);
    --fcal_cal_bg: var(--bde-background-color);
    --fcal_slot_border: color-mix(in srgb, var(--bde-body-text-color) 20%, transparent);
    --fcal_thBG: color-mix(in srgb, var(--bde-brand-primary-color) 8%, var(--bde-background-color));
    --fcal_enable_day_bg: color-mix(in srgb, var(--bde-brand-primary-color) 12%, var(--bde-background-color));
    --date-picker-selected-background: var(--bde-brand-primary-color);
    --date-picker-highlight-border: var(--bde-brand-primary-color);
    --date-picker-selected-color: var(--bde-background-color);
}
